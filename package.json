{
  "name": "little-archive",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted home for your saved discoveries",
  "license": "MIT",
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "test:web": "node --test web/*.test.mjs",
    "build:demo": "python3 scripts/build_demo.py",
    "test:extension": "node --test extension/tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:ai": "node tests/e2e/run.mjs --config tests/e2e/ai/playwright.config.mjs",
    "test:e2e:infra": "node --test tests/e2e/*.test.mjs",
    "test:extension:e2e": "node tests/e2e/run.mjs --config extension/tests/e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
