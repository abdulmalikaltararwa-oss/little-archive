# Copy to .env and replace the password, or run python3 scripts/setup.py.
LA_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
LA_PUBLIC_URL=http://localhost:8787
LA_DATA_DIR=./data
# Optional: your own Ollama server. No cloud provider is enabled by the app.
LA_OLLAMA_URL=
LA_OLLAMA_MODEL=

# Optional understanding layer (docs/understanding.md). Everything below is off unless set.
# A hosted provider needs LA_AI_PROVIDER=gemini AND a key; text is then sent to that service.
# LA_AI_PROVIDER=gemini
# LA_GEMINI_API_KEY=
# LA_GEMINI_MODEL=gemini-3.5-flash-lite
# Let the server read public pages itself (opt-in, SSRF-safe). Off by default.
# LA_FETCH_ENABLED=true
# Speech-to-text for "Read this more closely" and thin-caption videos (needs LA_FETCH_ENABLED).
# Either reuse the Gemini key above, or use Groq's Whisper:
# LA_TRANSCRIBE_PROVIDER=gemini
# LA_GROQ_API_KEY=
# Shared cache of results derived from public posts only. Off by default.
# LA_PUBLIC_CACHE=true
