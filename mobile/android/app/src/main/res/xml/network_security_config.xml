<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: https only. The app's own address check (mobile/src/server-url.js) refuses http except to this device;
     this is the same rule enforced by Android. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
