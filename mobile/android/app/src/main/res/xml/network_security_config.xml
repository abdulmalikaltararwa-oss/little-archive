<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: https only, to every host. The app's own address check (mobile/src/server-url.js) refuses plain http
     except to this device, and the emulator's 10.0.2.2 only in a development bundle; Android's rule is stricter than both,
     which fails closed. The debug build type has its own file (src/debug/res/xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
