<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is off so the sign-in token is never copied off the phone by a backup. networkSecurityConfig allows
         plain http only in debug builds, and only to this computer (res/xml in src/debug). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Appears in the share sheet for a link or text shared from another app. The app opens its save dialog with
                 it filled in; nothing is saved until the person taps Save. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Where Supabase sends the system browser back to after "Continue with Google", and where the link of a password-reset
                 email ends: littlearchive://auth-callback, and only that (this host; the iOS share extension's littlearchive://share
                 is not matched). SocialSignInPlugin takes it as the answer to a sign-in only while one this app started is waiting;
                 otherwise the page reads it only against a reset it asked for (mobile/src/recovery.js). The same address must be on
                 the Supabase project's redirect allow-list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="littlearchive" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The one-time unlock is bought through Google Play Billing. The library declares this too; it is stated here so the
         app's permissions can be read in one place. -->
    <uses-permission android:name="com.android.vending.BILLING" />
</manifest>
